rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    // Voice notes (AAC in an MP4/M4A container).
    function isVoice() {
      return request.resource.contentType in ['audio/mp4', 'audio/aac', 'audio/mpeg'];
    }

    // Documents (allowlist, same as the Firestore rules) and videos.
    function isDocument() {
      return request.resource.contentType in ['application/pdf', 'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.ms-excel',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        'application/vnd.ms-powerpoint',
        'application/vnd.openxmlformats-officedocument.presentationml.presentation',
        'text/plain', 'text/csv', 'application/zip'];
    }

    function isVideo() {
      return request.resource.contentType in ['video/mp4', 'video/quicktime'];
    }

    // Avatars: any signed-in user may read; only the owner writes.
    match /avatars/{uid}/{file} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && request.auth.uid == uid
                            && isImage()
                            && request.resource.size < 5 * 1024 * 1024;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Chat media: chatMedia/{conversationId}/{uploaderUid}/{fileId}
    match /chatMedia/{cid}/{uploaderUid}/{fileId} {
      function convPath() {
        return /databases/(default)/documents/conversations/$(cid);
      }
      function isMember() {
        return signedIn()
            && firestore.exists(convPath())
            && request.auth.uid in firestore.get(convPath()).data.memberIds;
      }

      allow read: if isMember();
      allow create, update: if isMember()
                            && request.auth.uid == uploaderUid
                            && (((isImage() || isVoice()) && request.resource.size < 10 * 1024 * 1024)
                                || (isDocument() && request.resource.size <= 25 * 1024 * 1024)
                                || (isVideo() && request.resource.size <= 50 * 1024 * 1024));
      allow delete: if signedIn() && request.auth.uid == uploaderUid;
    }

    // Group avatars: groupAvatars/{gid}/{fileId}. Members read, admins write.
    match /groupAvatars/{gid}/{fileId} {
      function gConvPath() {
        return /databases/(default)/documents/conversations/$(gid);
      }
      function isGroupMember() {
        return signedIn()
            && firestore.exists(gConvPath())
            && request.auth.uid in firestore.get(gConvPath()).data.get('memberIds', []);
      }
      function isGroupAdmin() {
        return signedIn()
            && firestore.exists(gConvPath())
            && request.auth.uid in firestore.get(gConvPath()).data.get('adminIds', []);
      }

      allow read: if isGroupMember();
      allow create, update: if isGroupAdmin()
                            && isImage()
                            && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isGroupAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
