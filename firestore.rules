rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isTs(v) {
      return v is timestamp;
    }

    function nullOrTs(d, k) {
      return d.get(k, null) == null || d[k] is timestamp;
    }

    function nullOrMinuteOfDay(d, k) {
      return d.get(k, null) == null || (d[k] is int && d[k] >= 0 && d[k] < 1440);
    }

    function nullOrBool(d, k) {
      return d.get(k, null) == null || d[k] is bool;
    }

    function nullOrString(d, k, maxLen) {
      return d.get(k, null) == null || (d[k] is string && d[k].size() <= maxLen);
    }

    function validUsername(u) {
      return u is string && u.matches('^[a-z0-9_]{3,20}$');
    }

    function isBlocked(blocker, target) {
      return exists(/databases/$(database)/documents/users/$(blocker)/blocks/$(target));
    }

    function convRef(cid) {
      return /databases/$(database)/documents/conversations/$(cid);
    }

    function isMember(cid) {
      return signedIn()
          && exists(convRef(cid))
          && request.auth.uid in get(convRef(cid)).data.memberIds;
    }

    function isGroupAdmin(cid) {
      return signedIn()
          && exists(convRef(cid))
          && request.auth.uid in get(convRef(cid)).data.get('adminIds', []);
    }

    // Membership as it will be after the current write batch commits.
    function isMemberAfter(cid) {
      return signedIn()
          && existsAfter(convRef(cid))
          && request.auth.uid in getAfter(convRef(cid)).data.memberIds;
    }

    // ---------- public profiles ----------
    match /publicProfiles/{uid} {
      function profileShape(d) {
        return d.keys().hasOnly(['uid', 'username', 'usernameLower', 'displayName',
                                 'photoPath', 'bio', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['uid', 'username', 'usernameLower', 'displayName',
                                'createdAt', 'updatedAt'])
            && d.uid == uid
            && validUsername(d.username)
            && d.usernameLower == d.username.lower()
            && d.usernameLower == d.username
            && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 50
            && nullOrString(d, 'photoPath', 300)
            && nullOrString(d, 'bio', 160)
            && isTs(d.createdAt) && isTs(d.updatedAt)
            // The username must be reserved in the same batch/transaction.
            && existsAfter(/databases/$(database)/documents/usernameIndex/$(d.usernameLower))
            && getAfter(/databases/$(database)/documents/usernameIndex/$(d.usernameLower)).data.uid == uid;
      }

      allow get: if signedIn();
      allow list: if false;
      allow create: if isOwner(uid) && profileShape(request.resource.data);
      allow update: if isOwner(uid) && profileShape(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false; // account deletion is performed by Cloud Function
    }

    // ---------- username index ----------
    match /usernameIndex/{usernameLower} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
                    && validUsername(usernameLower)
                    && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                    && request.resource.data.keys().hasAll(['uid', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && isTs(request.resource.data.createdAt)
                    && existsAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
                    && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.usernameLower == usernameLower;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- private user data ----------
    match /users/{uid} {
      match /private/settings {
        function settingsShape(d) {
          return d.keys().hasOnly(['notificationEnabled', 'showMessagePreview',
                                   'readReceiptsEnabled', 'lastSeenVisibility',
                                   'themeMode', 'updatedAt', 'quietHoursEnabled',
                                   'quietStartMin', 'quietEndMin', 'utcOffsetMin'])
              && nullOrBool(d, 'quietHoursEnabled')
              && nullOrMinuteOfDay(d, 'quietStartMin')
              && nullOrMinuteOfDay(d, 'quietEndMin')
              && (d.get('utcOffsetMin', null) == null
                  || (d.utcOffsetMin is int && d.utcOffsetMin >= -840 && d.utcOffsetMin <= 840))
              && nullOrBool(d, 'notificationEnabled')
              && nullOrBool(d, 'showMessagePreview')
              && nullOrBool(d, 'readReceiptsEnabled')
              && (d.get('lastSeenVisibility', null) == null
                  || d.lastSeenVisibility in ['everyone', 'contacts_or_chat_members', 'nobody'])
              && (d.get('themeMode', null) == null
                  || d.themeMode in ['system', 'light', 'dark'])
              && nullOrTs(d, 'updatedAt');
        }
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && settingsShape(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // NOTE: "users/{uid}/private/devices/{deviceId}" is not a valid document
      // path (odd segment count), so devices live in users/{uid}/devices/{deviceId}.
      match /devices/{deviceId} {
        function deviceShape(d) {
          return d.keys().hasOnly(['token', 'platform', 'appVersion', 'lastSeenAt'])
              && d.keys().hasAll(['token', 'platform', 'lastSeenAt'])
              && d.token is string && d.token.size() > 0 && d.token.size() <= 4096
              && d.platform in ['android', 'ios']
              && nullOrString(d, 'appVersion', 50)
              && isTs(d.lastSeenAt);
        }
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && deviceShape(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // Saved messages: private notes (typed, or copied from a chat). Owner only.
      match /saved/{noteId} {
        function noteShape(d) {
          return d.keys().hasOnly(['text', 'createdAt', 'sourceName'])
              && d.keys().hasAll(['text', 'createdAt'])
              && d.text is string && d.text.size() >= 1 && d.text.size() <= 4000
              && d.text.matches('(?s).*\\S.*')
              && d.createdAt == request.time
              && nullOrString(d, 'sourceName', 100);
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && noteShape(request.resource.data);
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      match /blocks/{blockedUid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
                      && blockedUid != uid
                      && request.resource.data.keys().hasOnly(['blockedUid', 'createdAt'])
                      && request.resource.data.keys().hasAll(['blockedUid', 'createdAt'])
                      && request.resource.data.blockedUid == blockedUid
                      && isTs(request.resource.data.createdAt);
        allow update: if false;
        allow delete: if isOwner(uid);
      }
    }

    // ---------- conversations ----------
    match /conversations/{cid} {
      function convShape(d) {
        return d.keys().hasOnly(['type', 'memberIds', 'createdBy', 'createdAt', 'updatedAt',
                                 'lastMessageId', 'lastMessageAt', 'lastMessagePreview',
                                 'lastSenderId'])
            && d.keys().hasAll(['type', 'memberIds', 'createdBy', 'createdAt', 'updatedAt'])
            && d.type == 'direct'
            && d.memberIds is list && d.memberIds.size() == 2
            && d.memberIds[0] is string && d.memberIds[1] is string
            && d.memberIds[0] < d.memberIds[1]
            && cid == d.memberIds[0] + '_' + d.memberIds[1]
            && d.createdBy == request.auth.uid
            && request.auth.uid in d.memberIds
            && d.createdAt == request.time
            && d.updatedAt == request.time
            && d.get('lastMessageId', null) == null
            && d.get('lastMessageAt', null) == null
            && d.get('lastMessagePreview', null) == null
            && d.get('lastSenderId', null) == null
            && exists(/databases/$(database)/documents/publicProfiles/$(d.memberIds[0]))
            && exists(/databases/$(database)/documents/publicProfiles/$(d.memberIds[1]))
            && !isBlocked(d.memberIds[0], d.memberIds[1])
            && !isBlocked(d.memberIds[1], d.memberIds[0]);
      }

      function validGroupName(n) {
        return n is string && n.trim().size() >= 1 && n.size() <= 50;
      }

      function validGroupPhoto(d) {
        return d.get('photoPath', null) == null
            || (d.photoPath is string && d.photoPath.matches('^groupAvatars/' + cid + '/.+'));
      }

      function uniqueList(l) {
        return l is list && l.toSet().size() == l.size();
      }

      // Group conversation at creation. NOTE: rules cannot iterate lists, so
      // they do not verify that every memberId has a profile / is a string,
      // nor per-pair blocks (blocks are not enforced in groups).
      function groupShape(d) {
        return d.keys().hasOnly(['type', 'memberIds', 'adminIds', 'name', 'photoPath', 'createdBy',
                                 'createdAt', 'updatedAt', 'lastMessageId', 'lastMessageAt',
                                 'lastMessagePreview', 'lastSenderId'])
            && d.keys().hasAll(['type', 'memberIds', 'adminIds', 'name', 'createdBy',
                                'createdAt', 'updatedAt'])
            && d.type == 'group'
            && cid.matches('^g_[a-z0-9]{32}$')
            && uniqueList(d.memberIds) && d.memberIds.size() >= 2 && d.memberIds.size() <= 20
            && d.createdBy == request.auth.uid
            && request.auth.uid in d.memberIds
            && d.adminIds == [d.createdBy]
            && validGroupName(d.name)
            && validGroupPhoto(d)
            && d.createdAt == request.time
            && d.updatedAt == request.time
            && d.get('lastMessageId', null) == null
            && d.get('lastMessageAt', null) == null
            && d.get('lastMessagePreview', null) == null
            && d.get('lastSenderId', null) == null;
      }

      // Common checks on the group doc after an update.
      function groupUpdateCommon(old, nw) {
        return old.get('type', null) == 'group'
            && nw.type == 'group'
            && uniqueList(nw.memberIds) && uniqueList(nw.adminIds)
            && nw.memberIds.hasAll(nw.adminIds)
            && validGroupName(nw.name)
            && validGroupPhoto(nw)
            && (!nw.diff(old).affectedKeys().hasAny(['updatedAt']) || nw.updatedAt == request.time);
      }

      // Disappearing-messages timer in seconds: off, 24 hours, 7 days, 90 days.
      function validTimer(d) {
        return d.get('disappearAfterSec', 0) in [0, 86400, 604800, 7776000];
      }

      // Direct chat: either member may change only the timer.
      function directTimerUpdate(old, nw) {
        return old.get('type', null) == 'direct'
            && request.auth.uid in old.memberIds
            && nw.diff(old).affectedKeys().hasOnly(['disappearAfterSec'])
            && nw.get('disappearAfterSec', null) is int
            && validTimer(nw);
      }

      // Admin: rename, change photo, add/remove members, promote/demote, set the timer.
      function adminUpdate(old, nw) {
        return request.auth.uid in old.adminIds
            && nw.diff(old).affectedKeys().hasOnly(['name', 'photoPath', 'memberIds', 'adminIds', 'updatedAt', 'disappearAfterSec'])
            && validTimer(nw)
            && groupUpdateCommon(old, nw)
            && nw.memberIds.size() >= 1 && nw.memberIds.size() <= 20
            && nw.adminIds.size() >= 1;
      }

      // Member leaves: removes only themselves. A leaving admin may promote
      // someone in the same write; a non-admin may not touch adminIds.
      function leaveUpdate(old, nw) {
        return request.auth.uid in old.memberIds
            && !(request.auth.uid in nw.memberIds)
            && nw.diff(old).affectedKeys().hasOnly(['memberIds', 'adminIds', 'updatedAt'])
            && groupUpdateCommon(old, nw)
            && nw.memberIds.size() == old.memberIds.size() - 1
            && old.memberIds.hasAll(nw.memberIds)
            && (nw.memberIds.size() == 0 || nw.adminIds.size() >= 1)
            && (request.auth.uid in old.adminIds || nw.adminIds == old.adminIds);
      }

      // Also serves `where memberIds array-contains uid` queries.
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && (convShape(request.resource.data) || groupShape(request.resource.data));
      // Direct chats: clients may change only the disappearing-messages timer
      // (summary fields: Cloud Functions only).
      // Groups: admin edits or a member leaving (see helpers above).
      allow update: if signedIn()
                    && (directTimerUpdate(resource.data, request.resource.data)
                        || (resource.data.get('type', null) == 'group'
                            && (adminUpdate(resource.data, request.resource.data)
                                || leaveUpdate(resource.data, request.resource.data))));
      allow delete: if false;

      // Join requests (admin approval). The requester is not a member, so they
      // may `get` only their own request.
      match /joinRequests/{ruid} {
        function inviteRef(code) {
          return /databases/$(database)/documents/groupInvites/$(code);
        }
        allow get: if isOwner(ruid) || isGroupAdmin(cid);
        allow list: if isGroupAdmin(cid);
        allow create: if isOwner(ruid)
                      && request.resource.data.keys().hasOnly(['uid', 'code', 'createdAt'])
                      && request.resource.data.keys().hasAll(['uid', 'code', 'createdAt'])
                      && request.resource.data.uid == ruid
                      && request.resource.data.code is string
                      && request.resource.data.code.matches('^[A-Za-z0-9]{10,24}$')
                      && request.resource.data.createdAt == request.time
                      && exists(convRef(cid))
                      && get(convRef(cid)).data.get('type', null) == 'group'
                      && !(ruid in get(convRef(cid)).data.memberIds)
                      && get(convRef(cid)).data.memberIds.size() < 20
                      && exists(inviteRef(request.resource.data.code))
                      && get(inviteRef(request.resource.data.code)).data.gid == cid
                      && get(inviteRef(request.resource.data.code)).data.active == true;
        allow update: if false;
        allow delete: if isOwner(ruid) || isGroupAdmin(cid);
      }

      match /members/{uid} {
        function memberShape(d) {
          return d.keys().hasOnly(['joinedAt', 'lastReadAt', 'mutedUntil', 'archived', 'pinned', 'clearedAt', 'chatTheme'])
              && d.keys().hasAll(['joinedAt'])
              && isTs(d.joinedAt)
              && nullOrTs(d, 'lastReadAt')
              && nullOrTs(d, 'mutedUntil')
              && nullOrTs(d, 'clearedAt')
              && nullOrBool(d, 'archived')
              && nullOrBool(d, 'pinned')
              && (d.get('chatTheme', null) == null
                  || d.chatTheme in ['ocean', 'violet', 'rose', 'sunset', 'forest', 'graphite']);
        }
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isMemberAfter(cid) && memberShape(request.resource.data);
        allow update: if isOwner(uid) && isMember(cid) && memberShape(request.resource.data)
                      && request.resource.data.joinedAt == resource.data.joinedAt;
        allow delete: if false;

        match /hidden/{messageId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid) && isMember(cid)
                        && request.resource.data.keys().hasOnly(['hiddenAt'])
                        && request.resource.data.keys().hasAll(['hiddenAt'])
                        && isTs(request.resource.data.hiddenAt);
          allow update: if false;
          allow delete: if isOwner(uid);
        }
      }

      // Delivery / read receipts. Each member writes only their own doc; the
      // other member can read it to show ticks. Read receipts are only written
      // by clients whose user has "read receipts" enabled.
      match /receipts/{uid} {
        function receiptShape(d) {
          return d.keys().hasOnly(['lastDeliveredAt', 'lastReadAt'])
              && d.keys().size() >= 1
              && nullOrTs(d, 'lastDeliveredAt')
              && nullOrTs(d, 'lastReadAt');
        }
        allow read: if isMember(cid);
        allow create, update: if isOwner(uid) && isMember(cid) && receiptShape(request.resource.data);
        allow delete: if false;
      }

      // Typing indicator: short-lived signal written by the typer (throttled
      // client-side) and read by the other member. Stale docs are ignored by
      // clients, so a crashed client never leaves "typing" stuck.
      match /typing/{uid} {
        allow read: if isMember(cid);
        allow create, update: if isOwner(uid) && isMember(cid)
                              && request.resource.data.keys().hasOnly(['typingAt'])
                              && request.resource.data.typingAt == request.time;
        allow delete: if isOwner(uid) && isMember(cid);
      }

      match /messages/{mid} {
        function otherMember(conv, uid) {
          return conv.memberIds[0] == uid ? conv.memberIds[1] : conv.memberIds[0];
        }

        function messageShape(d, cid) {
          return d.keys().hasOnly(['clientMessageId', 'senderId', 'type', 'text', 'mediaPath',
                                   'thumbnailPath', 'mimeType', 'sizeBytes', 'width', 'height',
                                   'replyToMessageId', 'createdAt', 'editedAt',
                                   'deletedForEveryoneAt', 'event', 'targetUid',
                                   'durationMs', 'waveform', 'expiresAt', 'timerSec', 'fileName', 'pageCount'])
              && d.keys().hasAll(['clientMessageId', 'senderId', 'type', 'createdAt'])
              && d.clientMessageId == mid
              && d.senderId == request.auth.uid
              && d.createdAt == request.time
              && d.get('editedAt', null) == null
              && d.get('deletedForEveryoneAt', null) == null
              && nullOrString(d, 'replyToMessageId', 128)
              && expiryOk(d, cid)
              && (d.type == 'file' || d.get('fileName', null) == null)
              && (d.type == 'file' || d.get('pageCount', null) == null)
              && (d.type == 'text' ? textMessage(d)
                  : (d.type == 'image' ? imageMessage(d, cid)
                  : (d.type == 'voice' ? voiceMessage(d, cid)
                  : (d.type == 'file' ? fileMessage(d, cid)
                  : (d.type == 'video' ? videoMessage(d, cid)
                  : (d.type == 'system' && systemMessage(d, cid)))))));
        }

        // Disappearing messages: when the chat has a timer, every non-system
        // message must carry `expiresAt` (a future time no later than the timer
        // plus 10 min of slack); otherwise it must not. A Firestore TTL policy on
        // `messages.expiresAt` deletes the document; clients hide it sooner.
        function expiryOk(d, cid) {
          let sec = get(convRef(cid)).data.get('disappearAfterSec', 0);
          return d.type == 'system' || sec == 0
              ? d.get('expiresAt', null) == null
              : (d.get('expiresAt', null) is timestamp
                 && d.expiresAt > request.time
                 && d.expiresAt <= request.time + duration.value(sec, 's') + duration.value(10, 'm'));
        }

        // Only voice messages may carry these.
        function noVoiceFields(d) {
          return d.get('durationMs', null) == null && d.get('waveform', null) == null;
        }

        // Voice note: audio uploaded to the sender's own chatMedia folder.
        // Max 5 minutes; `waveform` is a small list of bar heights (0..100) for
        // drawing the bubble without downloading the audio.
        function voiceMessage(d, cid) {
          return noSystemFields(d)
              && d.get('text', null) == null
              && d.get('thumbnailPath', null) == null
              && d.get('width', null) == null
              && d.get('height', null) == null
              && d.get('mediaPath', null) is string
              && d.mediaPath.matches('^chatMedia/' + cid + '/' + request.auth.uid + '/.+')
              && d.get('mimeType', null) in ['audio/mp4', 'audio/aac', 'audio/mpeg']
              && d.get('sizeBytes', null) is int
              && d.sizeBytes > 0 && d.sizeBytes <= 10 * 1024 * 1024
              && d.get('durationMs', null) is int
              && d.durationMs >= 500 && d.durationMs <= 5 * 60 * 1000
              && d.get('waveform', null) is list
              && d.waveform.size() >= 1 && d.waveform.size() <= 64;
        }

        // Document: uploaded to the sender's own chatMedia folder. Allowlisted
        // types only (no executables or archives other than zip), max 25 MB.
        function ownMedia(p, cid) {
          return p is string && p.matches('^chatMedia/' + cid + '/' + request.auth.uid + '/.+');
        }

        function fileMessage(d, cid) {
          return noSystemFields(d)
              && noVoiceFields(d)
              && d.get('text', null) == null
              && (d.get('thumbnailPath', null) == null
                  || (d.get('mimeType', null) == 'application/pdf' && ownMedia(d.thumbnailPath, cid)))
              && (d.get('pageCount', null) == null
                  || (d.get('mimeType', null) == 'application/pdf' && d.pageCount is int
                      && d.pageCount >= 1 && d.pageCount <= 100000))
              && d.get('width', null) == null
              && d.get('height', null) == null
              && d.get('mediaPath', null) is string
              && d.mediaPath.matches('^chatMedia/' + cid + '/' + request.auth.uid + '/.+')
              && d.get('mimeType', null) in ['application/pdf', 'application/msword',
                   'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                   'application/vnd.ms-excel',
                   'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                   'application/vnd.ms-powerpoint',
                   'application/vnd.openxmlformats-officedocument.presentationml.presentation',
                   'text/plain', 'text/csv', 'application/zip']
              && d.get('sizeBytes', null) is int
              && d.sizeBytes > 0 && d.sizeBytes <= 25 * 1024 * 1024
              && d.get('fileName', null) is string
              && d.fileName.size() >= 1 && d.fileName.size() <= 200;
        }

        // Video: MP4 / QuickTime, max 50 MB and 10 minutes. No thumbnail
        // (the bubble shows a play card sized from width/height).
        function videoMessage(d, cid) {
          return noSystemFields(d)
              && d.get('waveform', null) == null
              && d.get('text', null) == null
              && (d.get('thumbnailPath', null) == null || ownMedia(d.thumbnailPath, cid))
              && d.get('mediaPath', null) is string
              && d.mediaPath.matches('^chatMedia/' + cid + '/' + request.auth.uid + '/.+')
              && d.get('mimeType', null) in ['video/mp4', 'video/quicktime']
              && d.get('sizeBytes', null) is int
              && d.sizeBytes > 0 && d.sizeBytes <= 50 * 1024 * 1024
              && d.get('durationMs', null) is int
              && d.durationMs >= 300 && d.durationMs <= 10 * 60 * 1000
              && (d.get('width', null) == null || (d.width is int && d.width > 0))
              && (d.get('height', null) == null || (d.height is int && d.height > 0));
        }

        function noSystemFields(d) {
          return d.get('event', null) == null && d.get('targetUid', null) == null
              && d.get('timerSec', null) == null;
        }

        // "Disappearing messages set to X" notice: written in the same batch as
        // the timer change (getAfter sees the new value). Direct: either member;
        // group: admins only.
        function timerNotice(d, cid, conv) {
          return noVoiceFields(d)
              && d.get('text', null) == null
              && d.get('mediaPath', null) == null
              && d.get('thumbnailPath', null) == null
              && d.get('mimeType', null) == null
              && d.get('sizeBytes', null) == null
              && d.get('width', null) == null
              && d.get('height', null) == null
              && d.get('targetUid', null) == null
              && d.get('timerSec', null) in [0, 86400, 604800, 7776000]
              && d.timerSec is int
              && getAfter(convRef(cid)).data.get('disappearAfterSec', 0) == d.timerSec
              && request.auth.uid in conv.memberIds
              && (conv.get('type', null) == 'group' ? request.auth.uid in conv.adminIds : true);
        }

        // Group-only event message. 'left' is written in the same batch as the
        // leave update; get() sees pre-batch state, so the leaver is still a member.
        function systemMessage(d, cid) {
          let conv = get(convRef(cid)).data;
          return d.get('event', null) == 'timer' ? timerNotice(d, cid, conv)
              : (conv.get('type', null) == 'group'
              && noVoiceFields(d)
              && d.get('timerSec', null) == null
              && d.get('event', null) in ['added', 'removed', 'left', 'renamed']
              && d.get('text', null) == null
              && d.get('mediaPath', null) == null
              && d.get('thumbnailPath', null) == null
              && d.get('mimeType', null) == null
              && d.get('sizeBytes', null) == null
              && d.get('width', null) == null
              && d.get('height', null) == null
              && (d.event == 'renamed'
                  ? d.get('targetUid', null) == null
                  : (d.get('targetUid', null) is string && d.targetUid.size() >= 1 && d.targetUid.size() <= 128))
              && (d.event == 'left'
                  ? d.targetUid == request.auth.uid
                  : request.auth.uid in conv.adminIds));
        }

        function textMessage(d) {
          return noSystemFields(d)
              && noVoiceFields(d)
              && d.get('text', null) is string
              && d.text.size() >= 1 && d.text.size() <= 4000
              && d.text.matches('(?s).*\\S.*')
              && d.get('mediaPath', null) == null
              && d.get('thumbnailPath', null) == null
              && d.get('mimeType', null) == null
              && d.get('sizeBytes', null) == null
              && d.get('width', null) == null
              && d.get('height', null) == null;
        }

        function imageMessage(d, cid) {
          return noSystemFields(d)
              && noVoiceFields(d)
              && nullOrString(d, 'text', 1000)
              && d.get('mediaPath', null) is string
              && d.mediaPath.matches('^chatMedia/' + cid + '/' + request.auth.uid + '/.+')
              && (d.get('thumbnailPath', null) == null
                  || (d.thumbnailPath is string
                      && d.thumbnailPath.matches('^chatMedia/' + cid + '/' + request.auth.uid + '/.+')))
              && d.get('mimeType', null) in ['image/jpeg', 'image/png', 'image/webp']
              && d.get('sizeBytes', null) is int
              && d.sizeBytes > 0 && d.sizeBytes <= 10 * 1024 * 1024
              && (d.get('width', null) == null || (d.width is int && d.width > 0))
              && (d.get('height', null) == null || (d.height is int && d.height > 0));
        }

        function canSendDirect(conv) {
          let other = otherMember(conv, request.auth.uid);
          return request.auth.uid in conv.memberIds
              && !isBlocked(other, request.auth.uid)
              && !isBlocked(request.auth.uid, other);
        }

        // Groups: membership only. Per-pair blocks are NOT enforced (rules
        // cannot iterate over members).
        function canSend(cid) {
          let conv = get(convRef(cid)).data;
          return conv.get('type', null) == 'group'
              ? request.auth.uid in conv.memberIds
              : canSendDirect(conv);
        }

        allow read: if isMember(cid);
        allow create: if signedIn() && exists(convRef(cid))
                      && canSend(cid) && messageShape(request.resource.data, cid);
        // Messages are immutable for clients, except that the sender can
        // "delete for everyone" within 48h: content is wiped and a tombstone
        // timestamp is set. Nothing else may change.
        allow update: if signedIn() && isMember(cid)
                      && resource.data.senderId == request.auth.uid
                      && resource.data.get('type', null) != 'system'
                      && resource.data.get('deletedForEveryoneAt', null) == null
                      && request.time < resource.data.createdAt + duration.value(48, 'h')
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['deletedForEveryoneAt', 'text', 'mediaPath', 'thumbnailPath',
                                     'mimeType', 'sizeBytes', 'width', 'height',
                                     'durationMs', 'waveform', 'fileName', 'pageCount'])
                      && request.resource.data.deletedForEveryoneAt == request.time
                      && request.resource.data.get('text', null) == null
                      && request.resource.data.get('mediaPath', null) == null
                      && request.resource.data.get('thumbnailPath', null) == null;
        // Edit: the sender may change the text of their own text message within
        // 15 minutes. Only `text` and `editedAt` (server time) may change.
        allow update: if signedIn() && isMember(cid)
                      && resource.data.senderId == request.auth.uid
                      && resource.data.get('type', null) == 'text'
                      && resource.data.get('deletedForEveryoneAt', null) == null
                      && request.time < resource.data.createdAt + duration.value(15, 'm')
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['text', 'editedAt'])
                      && request.resource.data.editedAt == request.time
                      && request.resource.data.get('text', null) is string
                      && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 4000
                      && request.resource.data.text.matches('(?s).*\\S.*');
        allow delete: if false;

        match /reactions/{reactorUid} {
          allow read: if isMember(cid);
          allow create, update: if isOwner(reactorUid) && isMember(cid)
                                && request.resource.data.keys().hasOnly(['emoji', 'createdAt'])
                                && request.resource.data.keys().hasAll(['emoji', 'createdAt'])
                                && request.resource.data.emoji in ['👍', '❤️', '😂', '😮', '😢', '🙏']
                                && isTs(request.resource.data.createdAt);
          allow delete: if isOwner(reactorUid) && isMember(cid);
        }
      }
    }

    // ---------- group invites (code -> gid; join needs admin approval) ----------
    match /groupInvites/{code} {
      function inviteGroupName(gid) {
        return get(convRef(gid)).data.name;
      }
      allow get: if signedIn();
      // Only queries constrained to the caller's own invites.
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn()
                    && code.matches('^[A-Za-z0-9]{10,24}$')
                    && request.resource.data.keys().hasOnly(['gid', 'groupName', 'createdBy', 'createdAt', 'active'])
                    && request.resource.data.keys().hasAll(['gid', 'groupName', 'createdBy', 'createdAt', 'active'])
                    && request.resource.data.gid is string
                    && request.resource.data.gid.matches('^g_[a-z0-9]{32}$')
                    && isGroupAdmin(request.resource.data.gid)
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.active == true
                    && request.resource.data.groupName == inviteGroupName(request.resource.data.gid);
      allow update: if isGroupAdmin(resource.data.gid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'groupName'])
                    && request.resource.data.active is bool
                    && request.resource.data.groupName == inviteGroupName(resource.data.gid);
      allow delete: if isGroupAdmin(resource.data.gid);
    }

    // ---------- presence (online / last seen) ----------
    // Owner writes `lastActiveAt`; people who share a conversation with the
    // owner can read it. Users who hide their last seen delete the doc.
    match /presence/{uid} {
      function sharesConversation(a, b) {
        return exists(/databases/$(database)/documents/conversations/$(a < b ? a + '_' + b : b + '_' + a));
      }
      allow read: if isOwner(uid) || (signedIn() && sharesConversation(request.auth.uid, uid));
      allow create, update: if isOwner(uid)
                            && request.resource.data.keys().hasOnly(['lastActiveAt'])
                            && request.resource.data.lastActiveAt == request.time;
      allow delete: if isOwner(uid);
    }

    // ---------- anonymous account-deletion feedback (write-only) ----------
    match /deletionFeedback/{id} {
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['reason', 'details', 'createdAt'])
                    && request.resource.data.keys().hasAll(['reason', 'createdAt'])
                    && request.resource.data.reason in ['anotherAccount', 'privacy', 'notUsing',
                                                        'notifications', 'betterApp', 'other']
                    && nullOrString(request.resource.data, 'details', 500)
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // ---------- reports (write-only for clients) ----------
    match /reports/{id} {
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['reporterId', 'reportedUid',
                                                              'conversationId', 'messageId',
                                                              'reason', 'details', 'createdAt', 'status'])
                    && request.resource.data.keys().hasAll(['reporterId', 'reportedUid', 'reason',
                                                             'createdAt', 'status'])
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.reportedUid is string
                    && request.resource.data.reportedUid.size() > 0
                    && request.resource.data.reportedUid.size() <= 128
                    && nullOrString(request.resource.data, 'conversationId', 200)
                    && nullOrString(request.resource.data, 'messageId', 128)
                    && request.resource.data.reason in ['spam', 'harassment', 'inappropriate',
                                                        'impersonation', 'other']
                    && nullOrString(request.resource.data, 'details', 500)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.status == 'open';
      allow read, update, delete: if false;
    }

    // Server-only (idempotency markers, cleanup cursor).
    match /functionMarkers/{id} {
      allow read, write: if false;
    }

    // Catch-all deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
